<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Admin Login - Buoy ERP</title>
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@400;500;600;700;800;900&display=swap" rel="stylesheet">
  
  <!-- Instant Theme Detection (Zero-Flicker & Safe Storage) -->
  <script>
    (function() {
      try {
        var savedTheme = (typeof localStorage !== 'undefined' && localStorage.getItem('buoy_admin_theme')) || 'dark';
        document.documentElement.setAttribute('data-theme', savedTheme);
      } catch (_) {
        document.documentElement.setAttribute('data-theme', 'dark');
      }
    })();
  </script>

  <style>
    :root {
      --primary: #5B3DF5;
      --primary-light: #8166FF;
      --primary-dark: #4128C4;
      --accent: #7C3AED;
      --bg: #0D0D14;
      --surface: #16161F;
      --card: #1C1C28;
      --border: #2A2A3D;
      --divider: #252535;
      --text-primary: #EEEEF8;
      --text-secondary: #8888AA;
      --text-muted: #55556A;
      --error: #EF4444;
      --error-bg: rgba(239, 68, 68, 0.15);
      --error-border: rgba(239, 68, 68, 0.35);
      --success: #10B981;
    }

    [data-theme="light"] {
      --bg: #F8FAFC;
      --surface: #FFFFFF;
      --card: #FFFFFF;
      --border: #E2E8F0;
      --divider: #CBD5E1;
      --text-primary: #0F172A;
      --text-secondary: #64748B;
      --text-muted: #94A3B8;
    }

    * {
      box-sizing: border-box;
      margin: 0;
      padding: 0;
    }

    body {
      font-family: 'Plus Jakarta Sans', -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, sans-serif;
      background-color: var(--bg);
      color: var(--text-primary);
      min-height: 100vh;
      display: flex;
      justify-content: center;
      align-items: center;
      padding: 1.5rem;
      position: relative;
      overflow-x: hidden;
      transition: background-color 0.2s ease, color 0.2s ease;
    }

    /* Ambient background glow */
    body::before {
      content: '';
      position: absolute;
      top: -150px;
      left: 50%;
      transform: translateX(-50%);
      width: 600px;
      height: 350px;
      background: radial-gradient(circle, rgba(91, 61, 245, 0.18) 0%, rgba(13, 13, 20, 0) 70%);
      pointer-events: none;
      z-index: 0;
    }

    [data-theme="light"] body::before {
      background: radial-gradient(circle, rgba(91, 61, 245, 0.10) 0%, rgba(248, 250, 252, 0) 70%);
    }

    /* Top right theme toggle */
    .top-theme-toggle {
      position: absolute;
      top: 20px;
      right: 20px;
      z-index: 10;
    }

    .btn-theme-toggle {
      background: var(--card);
      border: 1px solid var(--border);
      color: var(--text-primary);
      padding: 7px 14px;
      border-radius: 12px;
      cursor: pointer;
      font-size: 12.5px;
      font-weight: 700;
      display: inline-flex;
      align-items: center;
      gap: 6px;
      transition: all 0.2s ease;
      font-family: inherit;
      user-select: none;
      box-shadow: 0 2px 8px rgba(0,0,0,0.06);
    }

    .btn-theme-toggle:hover {
      border-color: var(--primary);
      background: rgba(91, 61, 245, 0.08);
      transform: translateY(-1px);
    }

    .login-card {
      position: relative;
      z-index: 1;
      width: 100%;
      max-width: 420px;
      background: var(--card);
      border: 1px solid var(--border);
      border-radius: 24px;
      padding: 2.5rem 2rem;
      box-shadow: 0 10px 30px rgba(0, 0, 0, 0.45), 0 4px 12px rgba(0, 0, 0, 0.25);
      display: flex;
      flex-direction: column;
      align-items: center;
      transition: background-color 0.2s, border-color 0.2s;
    }

    [data-theme="light"] .login-card {
      box-shadow: 0 10px 30px rgba(0, 0, 0, 0.08), 0 4px 12px rgba(0, 0, 0, 0.04);
    }

    /* Authentic Buoy Logo Card Widget */
    .buoy-logo-card {
      width: 64px;
      height: 64px;
      background: #1E293B;
      border: 1.2px solid #334155;
      border-radius: 18px;
      box-shadow: 0 6px 20px rgba(0, 0, 0, 0.4);
      display: flex;
      flex-direction: column;
      justify-content: center;
      align-items: center;
      margin-bottom: 1.5rem;
      line-height: 0.85;
      user-select: none;
      transition: all 0.2s;
    }

    [data-theme="light"] .buoy-logo-card {
      background: #FFFFFF;
      border-color: #E2E8F0;
      box-shadow: 0 6px 20px rgba(0, 0, 0, 0.08);
    }

    .buoy-logo-row {
      display: flex;
      align-items: baseline;
      justify-content: center;
    }

    .char {
      font-family: 'Plus Jakarta Sans', Arial, sans-serif;
      font-weight: 900;
      line-height: 0.85;
    }

    .char-b { color: #2563EB; font-size: 21px; }
    .char-u { color: #EF4444; font-size: 19px; display: inline-block; transform: rotate(6.8deg); margin-left: 1px; }
    .char-o { color: #F59E0B; font-size: 21px; }
    .char-y { color: #EC4899; font-size: 23px; display: inline-block; transform: rotate(-5.7deg); margin-left: 1px; }
    .char-exc { color: #10B981; font-size: 24px; margin-left: 1px; }

    .badge-cloud {
      display: inline-flex;
      align-items: center;
      gap: 5px;
      background: rgba(91, 61, 245, 0.12);
      border: 1px solid rgba(91, 61, 245, 0.3);
      color: var(--primary);
      font-size: 10px;
      font-weight: 700;
      letter-spacing: 0.5px;
      text-transform: uppercase;
      padding: 4px 10px;
      border-radius: 12px;
      margin-bottom: 0.75rem;
    }

    [data-theme="dark"] .badge-cloud {
      color: var(--primary-light);
    }

    .badge-cloud .pulse-dot {
      width: 6px;
      height: 6px;
      border-radius: 50%;
      background: var(--primary-light);
      box-shadow: 0 0 8px var(--primary-light);
    }

    h1 {
      font-size: 24px;
      font-weight: 800;
      color: var(--text-primary);
      letter-spacing: -0.4px;
      margin-bottom: 0.35rem;
      text-align: center;
    }

    .subtitle {
      color: var(--text-secondary);
      font-size: 13.5px;
      text-align: center;
      margin-bottom: 2rem;
    }

    .error-banner {
      width: 100%;
      background: var(--error-bg);
      border: 1px solid var(--error-border);
      color: #EF4444;
      padding: 0.85rem 1rem;
      border-radius: 14px;
      font-size: 13px;
      font-weight: 600;
      margin-bottom: 1.5rem;
      display: flex;
      align-items: center;
      gap: 0.5rem;
    }

    [data-theme="dark"] .error-banner {
      color: #F87171;
    }

    form {
      width: 100%;
    }

    .form-group {
      margin-bottom: 1.25rem;
      display: flex;
      flex-direction: column;
      gap: 0.45rem;
    }

    label {
      font-size: 13px;
      font-weight: 700;
      color: var(--text-primary);
      letter-spacing: -0.2px;
    }

    .input-wrapper {
      position: relative;
    }

    input[type="text"],
    input[type="password"] {
      width: 100%;
      padding: 14px 16px;
      background: var(--surface);
      border: 1.2px solid var(--border);
      border-radius: 16px;
      color: var(--text-primary);
      font-family: inherit;
      font-size: 14px;
      outline: none;
      transition: all 0.2s ease;
    }

    input::placeholder {
      color: var(--text-muted);
    }

    input:focus {
      border-color: var(--primary);
      box-shadow: 0 0 0 3px rgba(91, 61, 245, 0.2);
      background: var(--surface);
    }

    .btn-submit {
      width: 100%;
      padding: 14px 20px;
      background: var(--primary);
      color: #FFFFFF;
      border: none;
      border-radius: 16px;
      font-family: inherit;
      font-size: 15px;
      font-weight: 700;
      letter-spacing: -0.2px;
      cursor: pointer;
      box-shadow: 0 4px 16px rgba(91, 61, 245, 0.4);
      transition: all 0.2s ease;
      margin-top: 0.5rem;
    }

    .btn-submit:hover {
      background: var(--primary-dark);
      transform: translateY(-1px);
      box-shadow: 0 6px 20px rgba(91, 61, 245, 0.5);
    }

    .btn-submit:active {
      transform: translateY(0);
    }

    .footer-note {
      margin-top: 1.75rem;
      font-size: 12px;
      color: var(--text-secondary);
      text-align: center;
      line-height: 1.5;
    }

    .footer-note a {
      color: var(--primary);
      text-decoration: none;
      font-weight: 600;
    }

    .footer-note a:hover {
      text-decoration: underline;
    }
    [data-lucide], svg.lucide {
      width: 16px;
      height: 16px;
      stroke-width: 2.2;
      vertical-align: middle;
      display: inline-block;
      flex-shrink: 0;
      stroke: currentColor;
      fill: none;
    }
  </style>
</head>
<body>
  <!-- Top Right Theme Toggle -->
  <div class="top-theme-toggle">
    <button type="button" class="btn-theme-toggle" id="themeToggleBtn" onclick="toggleTheme()" title="Toggle Theme">
      <span id="themeIcon"><i data-lucide="sun"></i></span>
      <span id="themeText">Light</span>
    </button>
  </div>

  <div class="login-card">
    <!-- Authentic Buoy Multi-Color Logo -->
    <div class="buoy-logo-card">
      <div class="buoy-logo-row">
        <span class="char char-b">b</span>
        <span class="char char-u">u</span>
      </div>
      <div class="buoy-logo-row">
        <span class="char char-o">o</span>
        <span class="char char-y">y</span>
        <span class="char char-exc">!</span>
      </div>
    </div>

    <div class="badge-cloud">
      <span class="pulse-dot"></span>
      Factory Cloud Administration
    </div>

    <h1>Buoy ERP Console</h1>
    <p class="subtitle">Secure administrative access for factory management</p>

    <% if (error) { %>
      <div class="error-banner">
        <i data-lucide="alert-triangle"></i>
        <span><%= error %></span>
      </div>
    <% } %>

    <form action="/admin/login" method="POST">
      <div class="form-group">
        <label for="email">Admin Email</label>
        <div class="input-wrapper">
          <input type="text" id="email" name="email" placeholder="mtkv@gmail.com" required autocomplete="username" autofocus>
        </div>
      </div>

      <div class="form-group">
        <label for="password">Security Password</label>
        <div class="input-wrapper">
          <input type="password" id="password" name="password" placeholder="••••••••" required autocomplete="current-password">
        </div>
      </div>

      <button type="submit" class="btn-submit">Sign In to Admin Console</button>
    </form>

    <div class="footer-note">
      Buoy ERP &copy; <%= new Date().getFullYear() %> &middot; Factory Cloud OS<br>
      <a href="/">Return to Main Application</a>
    </div>
  </div>

  <script>
    const BUOY_LOGIN_SVGS = {
      'sun': '<circle cx="12" cy="12" r="4"/><path d="M12 2v2"/><path d="M12 20v2"/><path d="m4.93 4.93 1.41 1.41"/><path d="m17.66 17.66 1.41 1.41"/><path d="M2 12h2"/><path d="M20 12h2"/><path d="m6.34 17.66-1.41 1.41"/><path d="m19.07 4.93-1.41 1.41"/>',
      'moon': '<path d="M12 3a6 6 0 0 0 9 9 9 9 0 1 1-9-9Z"/>',
      'alert-triangle': '<path d="m21.73 18-8-14a2 2 0 0 0-3.48 0l-8 14A2 2 0 0 0 4 21h16a2 2 0 0 0 1.73-3Z"/><line x1="12" y1="9" x2="12" y2="13"/><line x1="12" y1="17" x2="12.01" y2="17"/>'
    };

    function renderIcons() {
      if (window.lucide && typeof window.lucide.createIcons === 'function') {
        try {
          window.lucide.createIcons();
          return;
        } catch (_) {}
      }
      document.querySelectorAll('[data-lucide]').forEach(el => {
        const name = el.getAttribute('data-lucide');
        const inner = BUOY_LOGIN_SVGS[name];
        if (inner) {
          const cls = el.getAttribute('class') || '';
          const svg = document.createElementNS('http://www.w3.org/2000/svg', 'svg');
          svg.setAttribute('class', `lucide lucide-${name} ${cls}`.trim());
          svg.setAttribute('xmlns', 'http://www.w3.org/2000/svg');
          svg.setAttribute('width', '18');
          svg.setAttribute('height', '18');
          svg.setAttribute('viewBox', '0 0 24 24');
          svg.setAttribute('fill', 'none');
          svg.setAttribute('stroke', 'currentColor');
          svg.setAttribute('stroke-width', '2.2');
          svg.setAttribute('stroke-linecap', 'round');
          svg.setAttribute('stroke-linejoin', 'round');
          svg.innerHTML = inner;
          el.parentNode.replaceChild(svg, el);
        }
      });
    }

    function safeGetTheme() {
      try {
        return (typeof localStorage !== 'undefined' && localStorage.getItem('buoy_admin_theme')) || 'dark';
      } catch (_) {
        return 'dark';
      }
    }

    function safeSetTheme(val) {
      try {
        if (typeof localStorage !== 'undefined') localStorage.setItem('buoy_admin_theme', val);
      } catch (_) {}
    }

    function initTheme() {
      const current = document.documentElement.getAttribute('data-theme') || safeGetTheme();
      updateThemeUI(current);
    }

    function toggleTheme() {
      const current = document.documentElement.getAttribute('data-theme') || 'dark';
      const nextTheme = current === 'dark' ? 'light' : 'dark';
      document.documentElement.setAttribute('data-theme', nextTheme);
      safeSetTheme(nextTheme);
      updateThemeUI(nextTheme);
    }

    function updateThemeUI(theme) {
      const icon = document.getElementById('themeIcon');
      const text = document.getElementById('themeText');
      if (theme === 'light') {
        if (icon) icon.innerHTML = '<i data-lucide="moon"></i>';
        if (text) text.textContent = 'Dark';
      } else {
        if (icon) icon.innerHTML = '<i data-lucide="sun"></i>';
        if (text) text.textContent = 'Light';
      }
      renderIcons();
    }
    initTheme();
    renderIcons();
    document.addEventListener('DOMContentLoaded', renderIcons);
    window.addEventListener('load', renderIcons);
  </script>
</body>
</html>
