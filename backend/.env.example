# Buoy ERP Backend Environment Configuration

# Server Port
PORT=3000
NODE_ENV=development

# Supabase Configuration
SUPABASE_URL=https://your-project-id.supabase.co
SUPABASE_PUBLISHABLE_KEY=your-supabase-publishable-or-anon-key
SUPABASE_SECRET_KEY=your-supabase-secret-or-service-role-key

# Firebase Cloud Messaging Service Account (JSON string or file path)
# FIREBASE_SERVICE_ACCOUNT={"type":"service_account",...}
