{
  "buildCommand": "bash vercel-build.sh",
  "outputDirectory": "build/web",
  "functions": {
    "api/index.js": {
      "includeFiles": "backend/views/**"
    }
  },
  "redirects": [
    {
      "source": "/admin",
      "has": [
        {
          "type": "host",
          "value": "buoy-erp.vercel.app"
        }
      ],
      "destination": "https://buoy-erp-main.vercel.app/admin",
      "permanent": false
    },
    {
      "source": "/admin/:path*",
      "has": [
        {
          "type": "host",
          "value": "buoy-erp.vercel.app"
        }
      ],
      "destination": "https://buoy-erp-main.vercel.app/admin/:path*",
      "permanent": false
    }
  ],
  "rewrites": [
    { "source": "/download/(.*)", "destination": "/download/$1" },
    { "source": "/api/(.*)", "destination": "/api/index.js" },
    { "source": "/admin", "destination": "/api/index.js" },
    { "source": "/admin/(.*)", "destination": "/api/index.js" },
    { "source": "/((?!_vercel).*)", "destination": "/index.html" }
  ]
}
